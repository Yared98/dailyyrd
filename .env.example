PORT=8081
DATABASE_URL=data/daily.db
STATIC_DIR=../frontend/dist
RUST_LOG=backend=info,tower_http=info
RETENTION_DAYS=60
BOARD_RETENTION_DAYS=60

# Telemetria anônima com Umami (Opcional - deixe vazio para desativar)
